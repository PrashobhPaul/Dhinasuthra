<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 28+ adds display cutouts. shortEdges lets the app use the full screen,
      including the area beside a punch-hole or notch — which is only safe because
      every screen pads itself with WindowInsets.safeDrawing, which includes the
      displayCutout inset in both portrait and landscape.
    -->
    <style name="Theme.DhinaSuthra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand_amber</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
