<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ======================================================================
         Permission set (architecture.md §14, §63). Every permission maps to a
         visible core feature. Audited by scripts/audit-permissions.sh in CI.
         ====================================================================== -->

    <!-- Place recognition, travel inference (coarse first; fine required for geofencing radius accuracy) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Core product: routine understanding while the app is closed (Play declaration required — docs/play-store.md) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Movement state: STILL / WALKING / IN_VEHICLE transitions -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Routine reminders (runtime on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calls on your timeline. Optional and opt-in: the app asks only when you
         turn "Phone calls" on in Settings, and reads nothing until you do. Used
         solely to place answered calls on your own day; nothing is transmitted,
         because the app holds no INTERNET permission. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Contact names for those calls, so the timeline can say who you spoke to
         rather than showing a bare number. Same opt-in, same local-only rule. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- TV and viewing time. A special access, granted by the user in Android
         Settings rather than by a dialog, and read only for the small list of
         remote and video apps in AppSignalMap — every other app stays invisible. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Reboot recovery: re-register geofences, reschedule reminders (§31) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ======================================================================
         Core build is offline-first (§8): INTERNET is explicitly stripped even
         if a transitive dependency requests it. Ad-ID likewise (§33).
         ====================================================================== -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".DhinaSuthraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DhinaSuthra">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DhinaSuthra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Geofence transitions delivered by Play services via PendingIntent -->
        <receiver
            android:name=".sensing.geofence.GeofenceReceiver"
            android:exported="false" />

        <!-- Activity Recognition transitions delivered via PendingIntent -->
        <receiver
            android:name=".sensing.activity.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- Reboot recovery (§31): reschedule sensing + reminders; never restore stale reminders -->
        <receiver
            android:name=".sensing.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- WhatsApp and Teams calls, which never reach the system call log.
             Dormant until the user grants notification access in Android
             Settings. It reads no notification text of any kind: only which of
             four call apps posted it, whether a call clock is running, and when.
             Bound by the system alone via the signature-level permission below. -->
        <service
            android:name=".activity.CallNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Local reminder delivery (no cloud, no FCM — §9/§30) -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />
    </application>
</manifest>
